generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Credential {
  id            String   @id @default(cuid())
  ownerAddress  String   // Solana wallet address
  creditTier    Int      // 0-4
  claimsBitmap  Int
  issuedAt      DateTime
  expiresAt     DateTime
  issuerAddress String   // Verifier program ID
  isRevoked     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  loans         Loan[]
  @@index([ownerAddress])
  @@index([creditTier])
}

model Loan {
  id                String   @id @default(cuid())
  loanId            Int      // On-chain loan ID
  borrowerAddress   String
  collateralMint    String
  collateralAmount  String   // Stored as string for BigNumber
  borrowMint        String
  borrowAmount      String
  interestRate      Int      // Basis points
  collateralRatio   Int      // Basis points
  creditTierAtIssuance Int
  status            String   // active, repaid, liquidated
  repaidAmount      String   @default("0")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  credential        Credential @relation(fields: [borrowerAddress], references: [ownerAddress])
  @@index([borrowerAddress])
  @@index([status])
}

model Pool {
  id              String   @id @default(cuid())
  mintAddress     String   @unique
  symbol          String
  totalDeposits   String   @default("0")
  totalBorrows    String   @default("0")
  utilizationRate Float    @default(0)
  borrowApy       Float    @default(0)
  supplyApy       Float    @default(0)
  baseRate        Int      @default(200)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProtocolEvent {
  id          String   @id @default(cuid())
  eventType   String   // credential_issued, loan_created, loan_repaid, loan_liquidated
  data        String   // JSON blob
  slot        BigInt?
  signature   String?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}